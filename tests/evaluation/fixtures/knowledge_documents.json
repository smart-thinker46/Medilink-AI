  {"document_id":"EVAL-DOC-CLINICAL-001","organization_id":"org-001","facility_id":"facility-001","department_id":"clinical","title":"Clinical AI Safety Policy","document_type":"POLICY","classification":"RESTRICTED","version":"1.0","source_filename":"eval_clinical_ai_policy.pdf","allowed_roles":["CLINICAL_USER","CLINICAL_ADMIN"],"allowed_users":[],"effective_from":"2026-01-01","effective_until":null,"chunks":[{"chunk_id":"EVAL-CHUNK-CLINICAL-001","chunk_index":0,"section":"Human Approval","content":"Medilink AI must not independently authorize medication, approve patient discharge, approve surgery or make other clinical decisions reserved for qualified healthcare professionals. Such decisions require appropriate human professional review and authorization."}]},

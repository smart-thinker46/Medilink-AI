[
  {"document_id":"EVAL-DOC-POS-001","organization_id":"org-001","facility_id":"facility-001","department_id":"pharmacy","title":"Pharmacy POS Operations Guide","document_type":"SOP","classification":"INTERNAL","version":"1.0","source_filename":"eval_pharmacy_pos_sop.pdf","allowed_roles":["PHARMACY_ADMIN","PHARMACY_USER"],"allowed_users":[],"effective_from":"2026-01-01","effective_until":null,"chunks":[{"chunk_id":"EVAL-CHUNK-POS-001","chunk_index":0,"section":"Purpose","content":"The pharmacy POS manages retail pharmacy sales, payment processing, receipts, refunds, till operations and cash reconciliation."},{"chunk_id":"EVAL-CHUNK-POS-002","chunk_index":1,"section":"M-Pesa Exceptions","content":"When an M-Pesa payment is successful but is not recorded in the POS, staff should obtain the transaction reference, verify payment status using the approved process, check whether the payment is recorded against the POS transaction, and escalate unresolved discrepancies."}]},

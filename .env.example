# Keep this file as a template only. Never commit a real password.
DATABASE_URL=postgresql+psycopg://medilink_ai_app:CHANGE_THIS_TO_A_STRONG_PASSWORD@127.0.0.1:5432/medilink_ai
# Evaluation runs must use a separate database; never point this at production HMIS data.
EVALUATION_DATABASE_URL=postgresql+psycopg://medilink_ai_app:CHANGE_THIS_TO_A_STRONG_PASSWORD@127.0.0.1:5432/medilink_ai_eval

# Safe offline default. Use sentence-transformers only after installing the
# optional dependency and migrating pgvector to the model's dimension.
MEDILINK_EMBEDDING_BACKEND=hashing
MEDILINK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEDILINK_EMBEDDING_DIMENSION=256
